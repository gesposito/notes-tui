{
  "name": "notes-tui",
  "module": "src/app.tsx",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/app.tsx",
    "dev": "bun --watch src/app.tsx",
    "typecheck": "bun check",
    "fmt:check": "bun fmt --check",
    "test": "bun test",
    "verify": "bun run --parallel --no-exit-on-error fmt:check typecheck test",
    "build": "bun build --check --compile src/app.tsx --outfile notes-tui",
    "build:cli": "bun build --check --compile src/cli.ts --outfile notes",
    "build:helper": "swiftc -O helper/main.swift -framework ScriptingBridge -framework Foundation -o helper/notes-bridge",
    "cli": "bun run src/cli.ts",
    "grant-fda": "bun run scripts/grant-fda.ts",
    "start:bridge": "NOTES_BACKEND=scripting-bridge bun run src/app.tsx"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.3.0"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@opentui/core": "^0.6.8",
    "@opentui/react": "^0.6.8",
    "citty": "^0.2.2",
    "react": "^19.3.1"
  }
}
